<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- Cron job for Zulip Events API polling -->
    <record id="ir_cron_zulip_events" model="ir.cron">
        <field name="name">Zulip Events Polling</field>
        <field name="model_id" ref="mail_gateway_zulip.model_mail_gateway_zulip" />
        <field name="state">code</field>
        <field name="code">model._cron_poll_events()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root" />
    </record>
</odoo>
