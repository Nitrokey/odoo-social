<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mail_gateway_form_zulip" model="ir.ui.view">
        <field name="name">mail.gateway.form.zulip</field>
        <field name="model">mail.gateway</field>
        <field name="inherit_id" ref="mail_gateway.view_mail_gateway_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='gateway_type']" position="after">
                <field name="zulip_server_url" attrs="{'invisible': [('gateway_type', '!=', 'zulip')], 'required': [('gateway_type', '=', 'zulip')]}"/>
                <field name="zulip_bot_email" attrs="{'invisible': [('gateway_type', '!=', 'zulip')], 'required': [('gateway_type', '=', 'zulip')]}"/>
                <field name="zulip_api_key" password="True" attrs="{'invisible': [('gateway_type', '!=', 'zulip')], 'required': [('gateway_type', '=', 'zulip')]}"/>
                <field name="zulip_stream_filter" attrs="{'invisible': [('gateway_type', '!=', 'zulip')]}"/>
                <field name="zulip_topic_filter" attrs="{'invisible': [('gateway_type', '!=', 'zulip')]}"/>
            </xpath>
        </field>
    </record>

    <record id="view_mail_gateway_tree_zulip" model="ir.ui.view">
        <field name="name">mail.gateway.tree.zulip</field>
        <field name="model">mail.gateway</field>
        <field name="inherit_id" ref="mail_gateway.view_mail_gateway_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='gateway_type']" position="after">
                <field name="zulip_server_url" optional="hide"/>
                <field name="zulip_bot_email" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
